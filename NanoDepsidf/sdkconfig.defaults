# Baseline config deltas for NanoFOC_D. Kept as sdkconfig.defaults (not hand-edits to the
# generated per-env sdkconfig file) because raw edits to the generated file were found not
# to reliably survive rebuilds -- e.g. CONFIG_ESP_WIFI_ENABLED silently reverted to y.

# No WiFi/BLE in this project (see DEVELOPMENT_PLAN.md decisions log).
# NOTE: ESP_WIFI_ENABLED has no prompt in this IDF version (hidden symbol, hard-derived
# as "default y if SOC_WIFI_SUPPORTED" -- always true on S3, not a real toggle). It cannot
# be set from sdkconfig/defaults at all; confirmed empirically -- every attempt to disable
# it here was silently discarded on regen. The actual mechanism for "no WiFi" is simply
# never calling esp_wifi_init()/esp_netif_init(): the linker's dead-code elimination drops
# the WiFi driver automatically since nothing references it (confirmed: build stays at
# ~13% flash with zero WiFi calls in the app). BT_ENABLED is a real, promptable option:
# CONFIG_BT_ENABLED is not set

# NanoFOC_D has 4MB flash (board.json also sets this; kept here for robustness)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Found during Phase 8 display-performance debugging: this project had been building at
# ESP-IDF's DEFAULT debug optimization level (-Og-equivalent) and 160MHz this whole time --
# neither had ever been touched. Both affect CPU-bound work broadly, including the
# lv_draw_sw_rotate() software pixel-transpose esp_lvgl_port runs on every single flush
# because of this project's sw_rotate=true display config (display_task.c) -- a real,
# previously-unaccounted-for per-frame cost. Switched to the performance optimization
# profile and the S3's max clock.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Core 0 is architecturally dedicated exclusively to the control task (see
# DEVELOPMENT_PLAN.md, tasks_common.h) -- at CONTROL_LOOP_PERIOD_US=100 (10kHz) that task
# intentionally saturates Core 0, which starves IDLE0 and trips the task watchdog
# ("IDLE0 ... did not reset the watchdog in time") within seconds on real hardware. That's
# expected/intended for a core deliberately reserved for one real-time task, not a bug to
# fix by shrinking the control task's work further -- disable IDLE0 watchdog monitoring
# specifically (IDLE1 / Core 1 still monitored normally, since it isn't saturated).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Custom partition table -- also set via board_build.partitions in platformio.ini,
# which is what actually drives partition table generation under PlatformIO.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/nano_partitions.csv"

# Chip is ESP32-S3-N4R2: 4MB flash + 2MB PSRAM, both in-package. The 2MB (R2) PSRAM
# variant is always Quad SPI (Octal is only R8/R16 variants) -- confirmed against
# components/esp_psram/esp32s3/Kconfig.spiram before setting this, not guessed.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
# 80MHz: Quad PSRAM supports it without the experimental-feature caveat that applies at
# 120MHz. Was 40MHz for first hardware bring-up. PSRAM shares the cache and the SPI bus
# with flash, so Core 1's PSRAM traffic is quicker out of Core 0's way. Also changed
# directly in sdkconfig.esp32-s3-devkitm-1. If boot or PSRAM init ever fails, go back to
# CONFIG_SPIRAM_SPEED_40M=y in both files.
CONFIG_SPIRAM_SPEED_80M=y

# Phase 3: TinyUSB composite HID device (one interface, three report IDs -- keyboard,
# mouse, gamepad; see usb_task.c). This is the only sdkconfig entry TinyUSB's HID class
# needs -- endpoint size/polling interval/report-descriptor length are literal args in
# TUD_HID_DESCRIPTOR in usb_task.c, not Kconfig.
#
# 2 HID interfaces: the keyboard/mouse/gamepad one above, plus a vendor-defined raw 64-byte
# IN/OUT interface for host<->device data (icon upload -- see usb_task.c). Also changed
# directly in sdkconfig.esp32-s3-devkitm-1, since defaults don't override a saved value.
CONFIG_TINYUSB_HID_COUNT=2

# CDC-ACM, composited alongside HID (not a separate device) -- required, not optional:
# this board's upload flow (`use_1200bps_touch` in boards/nanofoc_d.json) depends on the
# *running* firmware exposing a USB-CDC serial port for PlatformIO/esptool to open and
# toggle at 1200 baud to trigger a reset into the bootloader. A HID-only descriptor has no
# such port, which would silently break `pio run -t upload` (falls back to needing the
# physical BOOT switch every time -- reserved for brick recovery only, not routine
# reflashing). Endpoint budget confirmed fine on hardware, not assumed: ESP32-S3's OTG FS
# controller has 7 total endpoint numbers / 5 usable IN slots (confirmed directly from
# TinyUSB's dwc2_esp32.h port source); CDC needs 2 IN + 1 OUT, HID's 3 report IDs share a
# single IN endpoint -- 3 IN + 1 OUT total, comfortably inside budget. Also fixes the
# secondary-console conflict noted in Phase 7's plan entry above (USB-Serial-JTAG can't
# coexist with TinyUSB on the same physical OTG PHY) by giving the running firmware its
# own CDC console instead.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# DEVICE -> SYS INFO shows per-core load from FreeRTOS run-time stats (the idle task's share
# of each core). Costs one esp_timer read per context switch. Also changed directly in
# sdkconfig.esp32-s3-devkitm-1, since defaults don't override a saved value.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# LVGL settings (CONFIG_LV_*) removed with the LovyanGFX migration -- LVGL is no longer
# in the build, so those symbols no longer exist.

# Timing: the 10 kHz control loop's IDF calls run from IRAM, not through the flash cache.
# Flash code shares the cache with Core 1, and once the companion work (LittleFS, cJSON,
# host link) grew Core 1's footprint, cache misses on Core 0 put ~1000 iterations a second
# over 60 us. Every tick does two context switches and a task notify (FreeRTOS -- in flash by
# default in this IDF), an SPI transaction (the MT6701), three MCPWM compare updates and four
# GPIO reads. ~20 KB of IRAM. Also changed directly in sdkconfig.esp32-s3-devkitm-1.
# sinf/cosf (inverse Park) follow through control_hot.lf, our own functions through CONTROL_HOT.
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# WiFi (net.c) -- added by the fork; the rest of the network stack stays off Core 0, which is
# the motor loop's: the radio's task and lwIP's on Core 1, mDNS's too (its own component). The
# WiFi driver's code stays in flash (IRAM is internal RAM), its buffers may go to PSRAM, and
# what this knob never does (be an access point, enterprise logins) isn't built in.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_MDNS_TASK_AFFINITY_CPU1=y
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# What WiFi turned out to cost, measured (SYS INFO, 20 s windows): 36 missed control ticks and
# 174 us worst jitter with the radio on, 0 and 77 us off -- in modem sleep the WiFi driver wakes
# the radio round every beacon with esp_timer callbacks, and esp_timer's task (priority 22) and
# ISR sat on Core 0, above the control task. They run on Core 1 now (nothing of ours uses
# esp_timer callbacks; esp_timer_get_time() is just a counter). And 110 KB of internal RAM:
# fewer buffers, and no A-MPDU (a knob setting its clock needs no aggregation).
# (ESP-IDF files the Core 1 placement under "experimental": checked on hardware -- WiFi, SNTP, USB,
# display, LEDs -- with the control loop's stats.)
CONFIG_ESP_TIMER_SHOW_EXPERIMENTAL=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU1=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU1=y
# Internal RAM again (2026-10-04): the frame sprite (115 KB) moved there for frame rate, which
# left ~18 KB free, 12 KB lowest (SYS INFO). The radio's buffers are internal (DMA): RX 16 -> 10
# (each ~1.6 KB, taken while packets wait; the companion's traffic is small, no A-MPDU), TX 6 -> 4.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
# TX buffers stay static (with SPIRAM_TRY_ALLOCATE_WIFI_LWIP ESP-IDF allows nothing else).
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# mbedTLS / PSA (the WiFi handshake's crypto, the companion link's keys) allocate from PSRAM; the
# AES / SHA engines copy through their own internal buffers. No TLS runs on the knob.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Plain malloc()s of 4 KB and up go to PSRAM (ESP-IDF's default keeps everything under 16 KB
# internal). Our own big buffers name their memory (heap_caps_malloc); this moves the libraries'
# mid-sized ones (cJSON's profile parsing, a loaded profile's icon).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Statics marked EXT_RAM_BSS_ATTR live in PSRAM (icon_store's buffers, the idle word's blocks).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
